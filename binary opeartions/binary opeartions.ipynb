   "cell_type": "code",
   "source": [
    "def b2d(b):\n",
    "    res = 0\n",
    "    while b>0:\n",
    "        dig = b % 10\n",
    "        res = res * 2 + dig\n",
    "        b = b // 10\n",
    "    return res\n",
    "\n",
    "print(b2d(1101))"
   ],
